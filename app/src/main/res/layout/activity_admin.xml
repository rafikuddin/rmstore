<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<!-- Fixed top: stays in place while the page below scrolls -->
<include layout="@layout/header_bar" />
<HorizontalScrollView android:id="@+id/tabScroll" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:scrollbars="none" android:overScrollMode="never" android:layout_marginBottom="8dp"
    android:paddingStart="16dp" android:paddingEnd="10dp" android:clipToPadding="false">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/tabUsers" android:text="👥 Users" android:gravity="center"
            android:textSize="12sp" android:textStyle="bold" android:paddingTop="9dp" android:paddingBottom="9dp"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:minWidth="84dp"
            android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tabNotices" android:text="📢 Notices" android:gravity="center"
            android:textSize="12sp" android:textStyle="bold" android:paddingTop="9dp" android:paddingBottom="9dp"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:minWidth="84dp"
            android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tabHolidays" android:text="🎉 Holiday" android:gravity="center"
            android:textSize="12sp" android:textStyle="bold" android:paddingTop="9dp" android:paddingBottom="9dp"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:minWidth="84dp"
            android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tabEntry" android:text="📝 Entry" android:gravity="center"
            android:textSize="12sp" android:textStyle="bold" android:paddingTop="9dp" android:paddingBottom="9dp"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:minWidth="84dp"
            android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tabReport" android:text="📊 Report" android:gravity="center"
            android:textSize="12sp" android:textStyle="bold" android:paddingTop="9dp" android:paddingBottom="9dp"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:minWidth="84dp"
            android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tabTarget" android:text="🎯 Targets" android:gravity="center"
            android:textSize="12sp" android:textStyle="bold" android:paddingTop="9dp" android:paddingBottom="9dp"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:minWidth="84dp"
            android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tabSms" android:text="📱 SMS" android:gravity="center"
            android:textSize="12sp" android:textStyle="bold" android:paddingTop="9dp" android:paddingBottom="9dp"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:minWidth="84dp"
            android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tabLeave" android:text="🌴 Leave" android:gravity="center"
            android:textSize="12sp" android:textStyle="bold" android:paddingTop="9dp" android:paddingBottom="9dp"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:minWidth="84dp"
            android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tabMenu" android:text="🧭 Menu" android:gravity="center"
            android:textSize="12sp" android:textStyle="bold" android:paddingTop="9dp" android:paddingBottom="9dp"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:minWidth="84dp"
            android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tabApp" android:text="📲 App" android:gravity="center"
            android:textSize="12sp" android:textStyle="bold" android:paddingTop="9dp" android:paddingBottom="9dp"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:minWidth="84dp"
            android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</HorizontalScrollView>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <LinearLayout android:id="@+id/adminContent" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="4dp" android:paddingBottom="24dp" />
</ScrollView>
<include layout="@layout/bottom_nav" />
</LinearLayout>
