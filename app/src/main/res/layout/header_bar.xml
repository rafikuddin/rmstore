<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_header" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="10dp" android:paddingBottom="30dp">
        <TextView android:id="@+id/btnBack" android:text="‹" android:textSize="26sp"
            android:textColor="@color/on_dark" android:gravity="center" android:clickable="true" android:focusable="true"
            android:background="@drawable/bg_icon_btn"
            android:layout_width="40dp" android:layout_height="40dp" />
        <TextView android:id="@+id/tvTitle" android:textSize="22sp" android:textStyle="bold"
            android:textColor="@color/on_dark" android:layout_marginStart="14dp"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <TextView android:id="@+id/btnRefresh" android:text="⟳" android:textSize="22sp" android:visibility="gone"
            android:textColor="@color/on_dark" android:gravity="center" android:clickable="true" android:focusable="true"
            android:background="@drawable/bg_icon_btn"
            android:layout_width="40dp" android:layout_height="40dp" />
    </LinearLayout>
    <!-- The light sheet that rises over the navy header with rounded top corners -->
    <View android:background="@drawable/bg_sheet_top"
        android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="-30dp" />
</LinearLayout>
