<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="@drawable/bg_nav" android:elevation="14dp"
        android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginBottom="12dp" android:layout_marginTop="4dp"
        android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="2dp">
    <LinearLayout android:id="@+id/navHome" android:orientation="vertical" android:gravity="center_horizontal"
        android:clickable="true" android:focusable="true"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="8dp">
        <View android:layout_width="22dp" android:layout_height="4dp" android:layout_marginBottom="4dp" />
        <TextView android:text="🏠" android:textSize="22sp" android:alpha="0.6"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="Home" android:textSize="10sp" android:textStyle="normal" android:textColor="@color/muted"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:id="@+id/navAttendance" android:orientation="vertical" android:gravity="center_horizontal"
        android:clickable="true" android:focusable="true"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="8dp">
        <View android:layout_width="22dp" android:layout_height="4dp" android:layout_marginBottom="4dp" />
        <TextView android:text="📸" android:textSize="22sp" android:alpha="0.6"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="Attendance" android:textSize="10sp" android:textStyle="normal" android:textColor="@color/muted"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:id="@+id/navLeave" android:orientation="vertical" android:gravity="center_horizontal"
        android:clickable="true" android:focusable="true"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="8dp">
        <View android:layout_width="22dp" android:layout_height="4dp" android:layout_marginBottom="4dp" />
        <TextView android:text="🌴" android:textSize="22sp" android:alpha="0.6"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="Leave" android:textSize="10sp" android:textStyle="normal" android:textColor="@color/muted"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:id="@+id/navTeam" android:orientation="vertical" android:gravity="center_horizontal"
        android:clickable="true" android:focusable="true" android:visibility="gone"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="8dp">
        <View android:layout_width="22dp" android:layout_height="4dp" android:layout_marginBottom="4dp" />
        <TextView android:text="👥" android:textSize="22sp" android:alpha="0.6"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="Team" android:textSize="10sp" android:textStyle="normal" android:textColor="@color/muted"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:id="@+id/navCalendar" android:orientation="vertical" android:gravity="center_horizontal"
        android:clickable="true" android:focusable="true"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="8dp">
        <View android:layout_width="22dp" android:layout_height="4dp" android:layout_marginBottom="4dp" />
        <TextView android:text="📅" android:textSize="22sp" android:alpha="0.6"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="Calendar" android:textSize="10sp" android:textStyle="normal" android:textColor="@color/muted"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:id="@+id/navNight" android:orientation="vertical" android:gravity="center_horizontal"
        android:clickable="true" android:focusable="true"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="8dp">
        <View android:layout_width="22dp" android:layout_height="4dp" android:layout_marginBottom="4dp" />
        <TextView android:text="🌙" android:textSize="22sp" android:alpha="0.6"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="Night Hold" android:textSize="10sp" android:textStyle="normal" android:textColor="@color/muted"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    </LinearLayout>
