<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Attendance" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:statusBarColor">@color/sky_top</item>
        <item name="materialButtonStyle">@style/Btn</item>
        <item name="materialCardViewStyle">@style/GlassCard</item>
    </style>
    <!-- Frosted white card: big soft corners, a light edge, gentle shadow -->
    <style name="GlassCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/glass</item>
        <item name="strokeColor">@color/glass_edge</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <!-- Main buttons: clay-brown pill (butter text; the other way round at night). Greys out automatically when disabled. -->
    <style name="Btn" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/btn_accent_tint</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">56dp</item>
    </style>
    <!-- White glossy pill with dark text (like Send / Request in the concept) -->
    <style name="BtnWhite" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/btn_white</item>
        <item name="android:textColor">@color/ink</item>
        <item name="rippleColor">#336B352A</item>
        <item name="cornerRadius">30dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:elevation">4dp</item>
    </style>
    <style name="BtnOutline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">28dp</item>
        <item name="strokeColor">@color/accent</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">56dp</item>
    </style>
    <!-- Labelled field ("Label input"): the label sits in the field as its placeholder, then lifts into the top edge and the outline parts around it.
         Soft 14dp corners, a quiet outline that turns to the accent colour (thicker) on focus. Used by the login and sign-up pages and by Fields.kt. -->
    <style name="Widget.Sam.Field" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/field_focus</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="endIconTint">@color/muted</item>
        <item name="helperTextTextColor">@color/muted</item>
    </style>
    <style name="ThemeOverlay.Sam.Field" parent="">
        <item name="textInputStyle">@style/Widget.Sam.Field</item>
    </style>
</resources>
